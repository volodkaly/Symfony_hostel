{% block body %}
  <div class="container mt-4" data-turbo="false">
    <div class="row">
      <div class="col-md-8 offset-md-2">
        <div id="chat-box" style="text-wrap: wrap; background: #f9f9f9; width: 100%;">
          <div id="status" class="text-muted small">Describe your problem</div>
        </div>

        <div class="input-group mb-3" style="width: 100%;">
          <input type="text" id="chat-text" class="form-control" placeholder="Type your message here..." />

          {% if 'ROLE_ADMIN' in app.user.roles %}
            <input type="number" id="recipient-id" class="form-control" placeholder="User ID" style="max-width: 100px;" />
          {% else %}
            <input type="hidden" id="recipient-id" value="" />
          {% endif %}

          <button class="btn btn-primary" id="btn-send">Send</button>
        </div>

        <div class="small text-muted">Your ID: {{ app.user.id }}</div>
      </div>
    </div>
  </div>

  <script data-turbo="false">
    ;(function () {
      const urlString = "{{ mercure_public_url|default('http://localhost:3000/.well-known/mercure') }}"
      const currentUserId = {{ app.user.id }}
      const topic = 'http://mysite.com/chat/{{ app.user.id }}'
    
      const hubUrl = new URL(urlString)
      hubUrl.searchParams.append('topic', topic)
    
      const eventSource = new EventSource(hubUrl)
    
      eventSource.onmessage = (event) => {
        const data = JSON.parse(event.data)
        const chatBox = document.getElementById('chat-box')
    
        if (displayedMessages.has(data.id)) {
          return
        }
        displayedMessages.add(data.id)
    
        const msgDiv = document.createElement('div')
        msgDiv.style.marginBottom = '5px'
        msgDiv.innerHTML = `<strong>User ${data.senderName || data.sender}:</strong> ${data.content}`
    
        chatBox.appendChild(msgDiv)
        chatBox.scrollTop = chatBox.scrollHeight
      }
    
      eventSource.onopen = () => {
        document.getElementById('status').innerText = 'Connected to chat.'
      }
    
      document.getElementById('btn-send').addEventListener('click', sendMessage)
      document.getElementById('chat-text').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') sendMessage()
      })
    
      function sendMessage() {
        const contentInput = document.getElementById('chat-text')
        const recipientInput = document.getElementById('recipient-id')
    
        const content = contentInput.value
        const recipientId = recipientInput.value
    
        if (!content.trim()) return
    
        const chatBox = document.getElementById('chat-box')
        const msgDiv = document.createElement('div')
        msgDiv.style.marginBottom = '5px'
        msgDiv.innerHTML = `<strong>You:</strong> ${content}`
        chatBox.appendChild(msgDiv)
        chatBox.scrollTop = chatBox.scrollHeight
    
        fetch('/api/message/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            content: content,
            recipientId: recipientId
          })
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error('Network response was not ok')
            }
            return response.json()
          })
          .then((data) => {
            console.log('Message saved:', data)
            contentInput.value = ''
          })
          .catch((error) => {
            console.error('Error:', error)
            alert('Error sending message')
          })
      }
    })()
  </script>
{% endblock %}

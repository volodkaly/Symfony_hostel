{% set test = 'test from room twig' %}
{% extends 'base.html.twig' %}

{% block title %}
  Rooms:
{% endblock %}

{% block body %}
  {% block header %}
    {{ parent() }}
  {% endblock %}

  <div class="example-wrapper">
    {% if (rooms|length) == 0 %}
      <p>No room was found yet</p>
    {% endif %}

    <div class="rooms-list">
      {% for room in rooms %}
        <div class="room-card">
          <h2>{{ room.name }}</h2>
          <div class="room-info">
            Price:
            <b>{{ room.price }}</b>
          </div>
          <div class="room-info">Capacity:
            {{ room.capacity }}</div>
          <div class="room-info">Rating:
            {{ room.average_rating }}</div>
          <div class="room-action">
            <form method="POST" action="{{ path('app_booking_new') }}" data-turbo="false">
              <input name="chosen_room" type="hidden" value="{{ room.id }}" />
              <button type="submit" class="book-btn">Book this room</button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if page > 1 %}
      <a href="{{ path('app_room', { page: page - 1 }) }}">Prev</a>
    {% endif %}
    <a href="{{ path('app_room', { page: page + 1 }) }}">Next</a>
  </div>
  <div class="room-filters">
    <form action="{{ path('app_room') }}" method="GET" id="filterForm">
      <label for="maxPrice">Choose max price per night:</label>
      <input type="range" id="maxPriceInput" name="maxPrice" value="{{ maxPrice|default('1001') }}" min="0" max="1001" />
      {{ maxPrice }}
      <br />
      <label for="minRating">Choose min average rating:</label>
      <input type="range" id="minRating" name="minRating" value="{{ minRating|default('1') }}" min="1" max="5" />
      {{ minRating }}
    </form>
    <div>{{ numberOfResults }} room(s) found.</div>
    <script>
      document.getElementById('maxPriceInput').addEventListener('change', function (e) {
        e.preventDefault()
        document.getElementById('filterForm').submit()
      })
      
      document.getElementById('minRating').addEventListener('change', function (e) {
        e.preventDefault()
        document.getElementById('filterForm').submit()
      })
    </script>
  </div>
{% endblock %}

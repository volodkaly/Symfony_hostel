{% extends 'base.html.twig' %}

{% block title %}
  New Booking
{% endblock %}

{% block body %}
  {% block header %}
    {{ parent() }}
  {% endblock %}

  <h1>Create new Booking</h1>

  {{ 'Price per night: ' }}<span id="price" data-price="{{ price }}">{{ price }}</span>
  {{ 'Total price: ' }}<span id="total_price"></span>
  {{ include('booking/_form.html.twig') }}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const startInput = document.getElementById('booking_start_date') || document.getElementById('booking_startDate')
      const endInput = document.getElementById('booking_end_date') || document.getElementById('booking_endDate')
      const totalSpan = document.getElementById('total_price')
      const totalInput = document.getElementById('booking_total_price')
      const priceSpan = document.getElementById('price')
    
      if (!startInput || !endInput) return
      const getDate = (input) => {
        const val = input.value || input.getAttribute('value')
        if (!val) return null
        if (val.includes('/')) {
          const [d, m, y] = val.split('/')
          return new Date(y, m - 1, d)
        }
        return new Date(val)
      }
    
      const calculate = () => {
        const start = getDate(startInput)
        const end = getDate(endInput)
        const price = parseFloat(priceSpan.innerText.replace(/[^\d.,]/g, '').replace(',', '.'))
    
        if (start && end && !isNaN(price)) {
          const days = Math.round((end - start) / (1000 * 60 * 60 * 24))
    
          if (days > 0) {
            const total = (days * price).toFixed(2)
            totalSpan.innerText = total
            if (totalInput) totalInput.value = total
          } else {
            totalSpan.innerText = '0.00'
          }
        }
      }
    
      ;[startInput, endInput].forEach((el) => {
        el.addEventListener('change', calculate)
        el.addEventListener('input', calculate)
      })
    
      calculate()
    })
  </script>

  <a href="{{ path('app_booking_index') }}" class="btn btn-primary">back to list</a>
{% endblock %}

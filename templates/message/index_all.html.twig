{% extends 'base.html.twig' %}

{% block title %}
  Message index
{% endblock %}

{% block body %}
  {% block header %}
    {{ parent() }}
  {% endblock %}
  <h1>All messages (seen by admin):</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Content</th>
        <th>CreatedAt</th>
        <th>Sender</th>
        <th>Recipient</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for message in messages %}
        <tr>
          <td>{{ message.id }}</td>
          <td>{{ message.content }}</td>
          <td>{{ message.createdAt ? message.createdAt|date('Y-m-d H:i:s') : '' }}</td>
          <td>{{ message.sender.name }}</td>
          <td>{{ message.recipient.name }}</td>
          <td>
            <a href="{{ path('app_message_show', { id: message.id }) }}">show</a>
            <a href="{{ path('app_message_edit', { id: message.id }) }}">edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4">no records found</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <a href="{{ path('app_message_new') }} " class="btn btn-primary">Create new</a>
{% endblock %}
